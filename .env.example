# ===========================================================================
# ORBIT — environment template
# ---------------------------------------------------------------------------
#   cp .env.example .env      then fill in the keys
#   nano .env                 (never commit .env — it is git-ignored)
# ===========================================================================

# --- AI providers ----------------------------------------------------------

# Google Gemini 2.5 Flash — primary decision engine.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — Llama-3 fallback for decisions + Whisper for speech-to-text.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# --- Telegram bridge (Phase 3) ---------------------------------------------

# Token from @BotFather, e.g. 123456789:AAE...
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (get it from @userinfobot). Only this chat
# is allowed to command ORBIT.
ADMIN_CHAT_ID=

# --- Assistant settings ----------------------------------------------------

# Name ORBIT introduces itself with.
ASSISTANT_NAME=Orbit

# Voice / TTS / STT language (bn-IN = Bengali-India; also good: bn-BD, en-IN).
ASSISTANT_LANGUAGE=bn-IN

# Hold a Termux wake-lock so the assistant keeps listening with the screen off.
WAKE_LOCK=true

# --- Optional tuning -------------------------------------------------------

# Whisper model used for speech-to-text.
# whisper-large-v3-turbo = fastest, whisper-large-v3 = most accurate.
WHISPER_MODEL=whisper-large-v3-turbo
